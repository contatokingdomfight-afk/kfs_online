{
  "name": "kfs-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 3000",
    "dev:mobile": "next dev -p 3000 -H 0.0.0.0",
    "prebuild": "node scripts/extract-body-map-svgs.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc.cjs",
    "seed:test-users": "tsx scripts/seed-test-users.ts",
    "seed:demo-anamnesis": "tsx scripts/seed-demo-anamnesis.ts",
    "seed:demo2": "tsx scripts/seed-demo2-user.ts",
    "process:brand-logo": "node scripts/process-brand-logo.mjs",
    "generate:pwa-icons": "node scripts/process-brand-logo.mjs && tsx scripts/generate-pwa-icons.ts",
    "cap:sync": "cap sync",
    "cap:sync:prod": "node scripts/cap-sync-prod.mjs",
    "cap:copy": "cap copy",
    "cap:open:android": "cap open android",
    "cap:android:test": "node scripts/cap-sync-prod.mjs && cap open android",
    "cap:open:ios": "cap open ios",
    "generate:capacitor-assets": "node scripts/prepare-capacitor-assets.mjs && capacitor-assets generate --ios --android",
    "list-humanoid-glb-bones": "tsx scripts/list-humanoid-glb-bones.ts",
    "clean": "node -e \"const fs=require('fs');const path=require('path');['.next','node_modules/.cache'].forEach(d=>{try{fs.rmSync(path.join(process.cwd(),d),{recursive:true,force:true});console.log('Removed',d);}catch(e){if(e.code!=='ENOENT')throw e;}});\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:migrate-data": "tsx scripts/migrate-old-db-to-eu.ts",
    "db:migrate-ama-only": "tsx scripts/migrate-old-db-to-eu.ts --ama-only",
    "db:migrate-extended": "tsx scripts/migrate-old-db-to-eu.ts --extended-only"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.62.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.0",
    "@vercel/analytics": "^2.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "html5-qrcode": "^2.3.8",
    "next": "15.5.14",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.2",
    "stripe": "^20.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.170.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@lhci/cli": "^0.14.0",
    "@next/bundle-analyzer": "^15.5.14",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.14",
    "pg": "^8.20.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  }
}
