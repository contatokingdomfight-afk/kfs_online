  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:mobile": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:test-users": "tsx scripts/seed-test-users.ts",
    "generate:pwa-icons": "tsx scripts/generate-pwa-icons.ts",
    "clean": "node -e \"const fs=require('fs');const path=require('path');['.next','node_modules/.cache'].forEach(d=>{try{fs.rmSync(path.join(process.cwd(),d),{recursive:true,force:true});console.log('Removed',d);}catch(e){if(e.code!=='ENOENT')throw e;}});\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
