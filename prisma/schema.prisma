// Kingdom Fight School – MVP
// Modelo alinhado aos DOCS (Modelo de Dados)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ALUNO
  COACH
  ADMIN
}

enum StudentStatus {
  ATIVO
  INADIMPLENTE
  INATIVO
  EXPERIMENTAL
}

enum AthleteLevel {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

enum PhysicalAssessmentRequestStatus {
  PENDING
  CANCELLED
  FULFILLED
}

enum AttendanceStatus {
  PENDING
  CONFIRMED
  ABSENT
}

enum CommentTargetType {
  ATHLETE
  LESSON
}

enum CommentVisibility {
  PRIVATE
  SHARED
}

enum PaymentStatus {
  PAID
  LATE
}

enum PaymentType {
  TUITION
  INSURANCE
  ENROLLMENT
}

enum FinancialExpenseKind {
  FIXED
  VARIABLE
}

// Escola física (suporta múltiplas unidades)
model School {
  id          String   @id @default(cuid())
  name        String
  address     String?
  city        String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  students                   Student[]
  schoolAssistantCoaches     SchoolAssistantCoach[]
  coachSchools               CoachSchool[]
  lessons                    Lesson[]
  locations                  Location[]
  plans                      Plan[]
  physicalAssessmentRequests PhysicalAssessmentRequest[]
  tribePosts                 TribePost[]
}

// Utilizador (sincronizado com Supabase Auth; role definido na plataforma)
model User {
  id         String   @id @default(cuid())
  authUserId String   @unique // ID do Supabase Auth (auth.uid())
  email      String
  name       String?
  role       Role
  /// Se "true" e `role` = ADMIN, aplica `UserAdminPermission`; se "false", trata-se como acesso total ao backoffice (legado / super).
  adminUseGranularPermissions Boolean @default(false)
  createdAt  DateTime @default(now())

  student              Student?
  coach                Coach?
  userAdminPermissions UserAdminPermission[]
  pushSubscriptions    PushSubscription[]
  tribePostsAuthored   TribePost[]         @relation("TribePostAuthor")
  tribePostsHidden     TribePost[]         @relation("TribePostHiddenBy")
  tribeComments        TribeComment[]      @relation("TribeCommentAuthor")
  tribeLikes           TribeLike[]
}

/// Conjunto canónico v1 (código estável) — ver `lib/permissions/constants.ts` e ecrã `/admin/permissoes`.
model AdminPermission {
  code      String   @id
  module    String
  labelPt   String
  labelEn   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  userGrants UserAdminPermission[]

  @@map("AdminPermission")
}

model UserAdminPermission {
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionCode String
  permission     AdminPermission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, permissionCode])
  @@index([userId])
  @@map("UserAdminPermission")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("PushSubscription")
}

model Student {
  id        String        @id @default(cuid())
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  status    StudentStatus @default(ATIVO)
  enrollmentFeeWaived Boolean @default(false)
  /// INVITE = convite por email; PRESENTIAL = secretaria criou conta com senha inicial.
  registrationMode    String  @default("INVITE")
  /// Login com email gerado (@alunos.kingdomfight.pt), sem caixa de correio real.
  syntheticLoginEmail Boolean @default(false)
  createdAt DateTime      @default(now())

  athlete     Athlete?
  attendances Attendance[]
  payments    Payment[]
  waiver      StudentWaiver?
  insuranceCoverage StudentInsuranceCoverage?
  physicalAssessments          StudentPhysicalAssessment[]
  physicalAssessmentRequests  PhysicalAssessmentRequest[]
  schoolAssistantCoach        SchoolAssistantCoach?
}

/// Aluno promovido a treinador assistente na escola (presenças; sem avaliações de desempenho).
model SchoolAssistantCoach {
  id               String    @id @default(cuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId        String    @unique
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grantedByUserId  String?
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  @@index([schoolId])
}

model PhysicalAssessmentRequest {
  id        String                          @id @default(cuid())
  studentId String
  student     Student                         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School                          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  status      PhysicalAssessmentRequestStatus @default(PENDING)
  note        String?
  createdAt   DateTime                        @default(now())
  fulfilledAt DateTime?

  @@index([schoolId, status])
}

model StudentPhysicalAssessment {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  coachId     String
  coach       Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  assessedAt  DateTime @db.Date
  nextDueAt   DateTime @db.Date
  clearance   String   // APTO | APTO_RESTRICOES | NECESSITA_AVALIACAO_MEDICA
  formData    Json     @default("{}")
  createdAt   DateTime @default(now())
}

model Athlete {
  id          String       @id @default(cuid())
  studentId   String       @unique
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level       AthleteLevel @default(INICIANTE)
  xp          Int          @default(0) // Gamificação: XP por conclusão de missões (avaliações)
  /// Índice da faixa mostrada (pode ficar atrás do XP até cumprir dias na faixa — ver lastBeltPromotionAt).
  displayBeltIndex     Int       @default(0)
  /// Início da permanência na faixa atual (para exigir tempo mínimo antes de subir).
  lastBeltPromotionAt  DateTime?
  mainCoachId String?
  mainCoach   Coach?       @relation("AthleteMainCoach", fields: [mainCoachId], references: [id])
  createdAt   DateTime     @default(now())
  missionAwards AthleteMissionAward[]
  missionCompletions AthleteMissionCompletion[]
}

model AthleteMissionAward {
  id            String   @id @default(cuid())
  athleteId     String
  athlete       Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  dimensionCode String
  targetScore   Int
  xpAwarded     Int      @default(50)
  createdAt     DateTime @default(now())

  @@unique([athleteId, dimensionCode, targetScore])
}

model MissionTemplate {
  id          String    @id @default(cuid())
  name        String
  description String?
  modality    String?
  beltIndex   Int?
  xpReward    Int       @default(50)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  completions AthleteMissionCompletion[]
}

model AthleteMissionCompletion {
  id               String         @id @default(cuid())
  athleteId        String
  athlete          Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  missionTemplateId String
  missionTemplate  MissionTemplate @relation(fields: [missionTemplateId], references: [id], onDelete: Cascade)
  completedAt      DateTime       @default(now())
  xpAwarded        Int            @default(0)

  @@unique([athleteId, missionTemplateId])
}

/// Escolas onde o professor pode lecionar (N:N).
model CoachSchool {
  coachId  String
  schoolId String
  coach    Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([coachId, schoolId])
}

model Coach {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId   String?  @unique // Permite que o coach também seja aluno
  specialties String?  // ex: "Muay Thai, Boxing" – pode evoluir para JSON
  createdAt   DateTime @default(now())

  coachSchools        CoachSchool[]
  lessons             Lesson[]
  comments            Comment[]
  athletesMainCoach   Athlete[] @relation("AthleteMainCoach")
  physicalAssessments StudentPhysicalAssessment[]
}

model Lesson {
  id             String    @id @default(cuid())
  modality       String
  /// Null = horário recorrente (usa weekday); preenchido = aula única ou ocorrência base.
  date           DateTime? @db.Date
  weekday        Int?
  startTime      String    // "HH:mm"
  endTime        String    // "HH:mm"
  coachId        String
  coach          Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  capacity       Int?
  planningNotes  String?
  isOneOff       Boolean   @default(false) // true = aula única (evento); false = recorrente semanal
  isOpenClass    Boolean   @default(false) // true = aula aberta a qualquer modalidade da escola
  /// true = restrita a alunos com registo de Atleta (ex.: treino de competição). Continua visível na agenda para todos, com etiqueta.
  athletesOnly   Boolean   @default(false)
  /// Quando false, a turma não aparece no formulário público /aula-experimental (útil para testes ou horários internos).
  offerTrialBooking Boolean @default(true)
  createdAt      DateTime  @default(now())

  attendances Attendance[]
  trialClasses TrialClass[]
}

model Attendance {
  id             String           @id @default(cuid())
  lessonId       String
  lesson         Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         AttendanceStatus @default(PENDING)
  isExperimental Boolean          @default(false)
  createdAt      DateTime         @default(now())
  occurrenceDate DateTime         @db.Date
  checkedInAt    DateTime?        @db.Timestamptz(6)
  rpe            Int?             @db.SmallInt
  rpeRecordedAt  DateTime?        @db.Timestamptz(6)
  postWeightKg   Decimal?           @db.Decimal(5, 2)
  postWeightRecordedAt DateTime?    @db.Timestamptz(6)
  countsForGamification Boolean   @default(true)

  @@unique([lessonId, studentId, occurrenceDate])
}

model TrialClass {
  id                String    @id @default(cuid())
  name              String
  contact           String
  modality          String
  lessonDate        DateTime  @db.Date
  lessonId          String?
  lesson            Lesson?   @relation(fields: [lessonId], references: [id])
  acceptedAt        DateTime? // pedido aceite (antes de converter em aluno)
  convertedToStudent Boolean  @default(false)
  createdAt         DateTime  @default(now())
}

// Comentários do coach: targetType + targetId (polimórfico – Athlete ou Lesson)
model Comment {
  id             String             @id @default(cuid())
  authorCoachId  String
  authorCoach    Coach              @relation(fields: [authorCoachId], references: [id], onDelete: Cascade)
  targetType     CommentTargetType
  targetId       String             // ID do Athlete ou da Lesson
  content        String
  visibility     CommentVisibility  @default(PRIVATE)
  createdAt      DateTime           @default(now())
}

model Payment {
  id              String        @id @default(cuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus
  paymentType     PaymentType   @default(TUITION)
  referenceMonth  String?       // "YYYY-MM" (TUITION)
  referenceYear   String?       // "YYYY" (INSURANCE)
  stripeInvoiceId String?       @unique
  createdAt       DateTime      @default(now())
}

model InsuranceSettings {
  id              String   @id @default("global")
  annualAmount    Decimal  @db.Decimal(10, 2)
  enrollmentAmount Decimal @default(0) @db.Decimal(10, 2)
  policyReference String?
  waiverVersion   String   @default("1")
  updatedAt       DateTime @default(now())

  @@map("InsuranceSettings")
}

model StudentWaiver {
  id             String    @id @default(cuid())
  studentId      String    @unique
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  waiverSigned   Boolean   @default(false)
  waiverSignedAt DateTime?
  waiverVersion  String?
  signatureName  String?
  signatureIp    String?
  guardianName   String?
  isMinor        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@map("StudentWaiver")
}

model StudentInsuranceCoverage {
  id                  String    @id @default(cuid())
  studentId           String    @unique
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  covered             Boolean   @default(false)
  coverageStartDate   DateTime? @db.Date
  coverageEndDate     DateTime? @db.Date
  policyReference     String?
  notes               String?
  lastRenewedAt       DateTime?
  lastRenewedByUserId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now())

  @@map("StudentInsuranceCoverage")
}

/// Eventos Stripe já processados (idempotência do webhook).
model StripeWebhookEvent {
  eventId     String   @id
  processedAt DateTime @default(now())

  @@map("StripeWebhookEvent")
}

/// Despesa geral (custos) registada no painel financeiro admin. `kind` distingue despesas fixas (aluguer, assinaturas) de variáveis.
model FinancialExpense {
  id          String               @id @default(cuid())
  amount      Decimal              @db.Decimal(10, 2)
  description String
  occurredOn  DateTime             @db.Date
  /// FIXA: custo recorrente previsível; VARIÁVEL: varia mês a mês.
  kind        FinancialExpenseKind @default(VARIABLE)
  createdAt   DateTime             @default(now())

  @@map("FinancialExpense")
}

/// Receita manual (entradas noutras rubricas) registada no painel financeiro admin.
model FinancialRevenue {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(10, 2)
  description String
  occurredOn  DateTime @db.Date
  createdAt   DateTime @default(now())

  @@map("FinancialRevenue")
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  lessons Lesson[]
}

model Plan {
  id                      String   @id @default(cuid())
  name                    String
  description             String?
  priceMonthly            Decimal  @db.Decimal(10, 2)
  schoolId                String
  school                  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  includesDigitalAccess   Boolean  @default(false)
  modalityScope           String   @default("ALL") // NONE | SINGLE | ALL
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

enum TribePostVisibility {
  SCHOOL_ONLY
  ALL_SCHOOLS
}

enum TribePostStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum TribeCommentStatus {
  ACTIVE
  HIDDEN
}

model TribePost {
  id               String              @id @default(cuid())
  schoolId         String
  school           School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  authorUserId     String
  author           User                @relation("TribePostAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  body             String
  visibility       TribePostVisibility @default(SCHOOL_ONLY)
  status           TribePostStatus     @default(ACTIVE)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  hiddenAt         DateTime?
  hiddenByUserId   String?
  hiddenBy         User?               @relation("TribePostHiddenBy", fields: [hiddenByUserId], references: [id], onDelete: SetNull)

  media    TribePostMedia[]
  comments TribeComment[]
  likes    TribeLike[]

  @@index([schoolId, createdAt(sort: Desc)])
  @@index([visibility, status, createdAt(sort: Desc)])
}

model TribePostMedia {
  id        String    @id @default(cuid())
  postId    String
  post      TribePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  publicUrl String
  mimeType  String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([postId])
}

model TribeComment {
  id           String             @id @default(cuid())
  postId       String
  post         TribePost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User               @relation("TribeCommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  body         String
  status       TribeCommentStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())

  @@index([postId, createdAt])
}

model TribeLike {
  id        String    @id @default(cuid())
  postId    String
  post      TribePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
  @@index([postId])
}
