# Supabase (https://supabase.com) – Auth + Database
NEXT_PUBLIC_SUPABASE_URL=https://teu-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Database (usa o mesmo projeto Supabase – Connection string em Project Settings > Database)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Migração de dados do projeto Supabase antigo → EU (ver scripts/migrate-old-db-to-eu.ts)
# OLD_DATABASE_URL="postgresql://postgres:...@db.[ref-antigo].supabase.co:5432/postgres"
# Completar só prémios de missão: npm run db:migrate-ama-only
# Após aplicar supabase/migrations/20260414130000_eu_legacy_schema_parity.sql no EU: npm run db:migrate-extended

# Notificações por email (Resend – https://resend.com)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Kingdom Fight School <noreply@teudominio.com>

# Cron: mesmo segredo para todos os GET /api/cron/* (Authorization: Bearer … ou x-vercel-cron na Vercel)
# - /api/cron/lesson-reminders — lembretes de aulas (email)
# - /api/cron/payment-suspension — gera Payment LATE (mês anterior + corrente, Lisboa) + suspende após prazo
# - /api/cron/generate-monthly-payments — opcional; ver DOCS/PAGAMENTOS_MENSALIDADES_CRON.md
CRON_SECRET=um_segredo_forte_aqui

# URL pública da app (opcional; usada em alguns fluxos, ex. QR check-in em produção)
# NEXT_PUBLIC_APP_URL=https://teu-dominio.vercel.app
# NEXT_PUBLIC_SITE_URL=https://kingdomfight.com

# Capacitor (Android/iOS) — URL que o WebView abre; ver DOCS/CAPACITOR.md
# CAPACITOR_SERVER_URL=https://kingdomfight.com
# Dev emulador Android: CAPACITOR_SERVER_URL=http://10.0.2.2:3000

# Opcional: password partilhada pelas contas criadas com `npm run seed:test-users`
# TEST_SEED_PASSWORD=uma_password_segura_aqui
# Em produção os scripts seed:* recusam correr salvo:
# ALLOW_PRODUCTION_SEED=true

# Stripe – pagamentos e assinaturas (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook: stripe listen --forward-to localhost:3000/api/stripe/webhook → copiar signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry – monitorização de erros em produção (https://sentry.io)
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# SENTRY_AUTH_TOKEN=...  # opcional: upload de source maps em CI/CD
# SENTRY_ORG=...
# SENTRY_PROJECT=...

# Google OAuth (opcional - configurado no Supabase)
# Ver: DOCS/GOOGLE_OAUTH_SETUP.md para instruções completas
NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-abc123...
